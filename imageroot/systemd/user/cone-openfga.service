[Unit]
StartLimitIntervalSec=120
StartLimitBurst=3
Description=C1 openfga
BindsTo=cone.service
After=cone.service cone-openfga-migrate.service
Requires=cone-openfga-migrate.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/cone-openfga.pid %t/cone-openfga.ctr-id
ExecStart=/usr/bin/podman run --user=0 --detach --memory=256m --conmon-pidfile=%t/cone-openfga.pid --cidfile=%t/cone-openfga.ctr-id --cgroups=no-conmon --pod-id-file=%t/cone.pod-id --replace --name=cone-openfga --env-file=private/openfga.env ${OPENFGA_IMAGE} run
ExecStartPost=runagent wait-backend openfga
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/cone-openfga.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/cone-openfga.ctr-id
PIDFile=%t/cone-openfga.pid
Type=forking
