[Unit]
StartLimitIntervalSec=120
StartLimitBurst=3
Description=C1 postgres
BindsTo=cone.service
After=cone.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/private/volumes.env
WorkingDirectory=%E/state
Restart=on-failure
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/cone-postgres.pid %t/cone-postgres.ctr-id
ExecStart=/usr/bin/podman run --user=0 --detach --memory=256m --conmon-pidfile=%t/cone-postgres.pid --cidfile=%t/cone-postgres.ctr-id --cgroups=no-conmon --pod-id-file=%t/cone.pod-id --replace --name=cone-postgres --volume=${CONE_POSTGRES_VOLUME}:/var/lib/postgresql/data:Z --env-file=private/postgres.env ${POSTGRES_IMAGE} postgres -c listen_addresses=127.0.0.1
ExecStartPost=runagent wait-backend postgres
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/cone-postgres.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/cone-postgres.ctr-id
PIDFile=%t/cone-postgres.pid
Type=forking
