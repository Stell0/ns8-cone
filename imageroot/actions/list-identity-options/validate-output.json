{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "providers",
    "domains"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "host",
          "module_uuid"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "module_uuid": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
