import json
import ssl
import sys
import agent
from agent.ldapproxy import Ldapproxy
from cone_state import validate_settings

request = json.load(sys.stdin)
def fail(field, error):
    agent.set_status("validation-failed")
    # Do not echo request values, including CA or future enrollment material.
    json.dump([{"field": field, "parameter": field, "value": "", "error": error}], sys.stdout)
    sys.exit(3)
error = validate_settings(request)
if error:
    fail(*error)
providers = agent.list_service_providers(agent.redis_connect(use_replica=True), "oidc", "http",
                                        {"module_id": request["idp_provider"]})
if len(providers) != 1:
    fail("idp_provider", "provider_unavailable")
if Ldapproxy().get_domain(request["user_domain"]) is None:
    fail("user_domain", "domain_unavailable")
prefix = providers[0].get("issuer_url_prefix", "")
if not prefix.startswith("https://") or not prefix.endswith("/") or any(c in prefix for c in "\r\n\x00"):
    fail("idp_provider", "invalid_issuer")
if request.get("issuer_ca_pem"):
    try:
        ssl.create_default_context(cadata=request["issuer_ca_pem"])
    except (ValueError, ssl.SSLError):
        fail("issuer_ca_pem", "invalid_ca")
