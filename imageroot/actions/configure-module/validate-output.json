{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "configured",
    "state",
    "draft_saved",
    "blockers"
  ],
  "properties": {
    "configured": {
      "type": "boolean"
    },
    "state": {
      "type": "string"
    },
    "draft_saved": {
      "const": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
