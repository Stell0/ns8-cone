#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Protected local operator entry point. No HTTP privilege bypass."""
import argparse
import json
from pathlib import Path
import sys
from cone_recovery import restore, verify, release
p=argparse.ArgumentParser()
commands=p.add_subparsers(dest='command',required=True)
r=commands.add_parser('restore');r.add_argument('--directory',type=Path,required=True);r.add_argument('--operator',required=True)
for name in ['verify','release']:
 r=commands.add_parser(name);r.add_argument('--namespace-evidence',type=Path,required=True);r.add_argument('--token-file',type=Path,required=True)
 if name=='release':
  r.add_argument('--accept-security-as-of',required=True);r.add_argument('--reason',required=True);r.add_argument('--operator',required=True)
a=p.parse_args()
try:
 if a.command=='restore': result=restore(a.directory,a.operator)
 elif a.command=='verify': result=verify(a.namespace_evidence,a.token_file)
 else: result=release(a.namespace_evidence,a.token_file,a.accept_security_as_of,a.reason,a.operator)
 print(json.dumps(result,sort_keys=True))
except ValueError as error:
 print(json.dumps({'contract_version':1,'error':str(error)}));sys.exit(2)
except Exception:
 print(json.dumps({'contract_version':1,'error':'recovery_unavailable'}));sys.exit(4)
